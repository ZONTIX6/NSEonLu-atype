{
    // F5/Jlink-attach 跟随 BOARD_FLASH_TARGET；DAP-attach 固定使用第一块主板 ELF。
    "version": "0.2.0",
    "configurations": [
         {
        "name": "ST-Link",
         "cwd": "${workspaceRoot}",
        "executable": "${workspaceRoot}\\build\\selected-board.elf",
        "request": "launch",
        "type": "cortex-debug",

        "device": "STM32F427II",
        "svdFile": "STM32F427.svd",

        "servertype": "openocd",
        "configFiles": [
            "openocd_stlink.cfg"
      ],

        "runToEntryPoint": "main",
        "rtos": "FreeRTOS",
        "preLaunchTask": "build selected board for debug",

        "liveWatch": {
          "enabled": true,
          "samplesPerSecond": 10
      }
        },
        
        // 使用dap-link(如无线调试器时的参考配置)
        {
            "name": "DAPlink",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}\\build\\selected-board.elf",
            "request": "launch",
            "type": "cortex-debug",
            //使用J-link GDB Server时必须;其他GBD Server时可选（有可能帮助自动选择SVD文件）
            //支持的设备见 https://www.segger.com/downloads/supported-devices.php
            "device": "STM32F427II",
            //svd文件，有这个文件才能查看寄存器的值，每个单片机都不同。可以在以下地址找到 https://github.com/posborne/cmsis-svd
            //该项目的根目录已经提供了C型开发板使用的外设svd文件
            "svdFile": "STM32F427.svd",
            "servertype": "openocd", //使用的GDB Server
            "configFiles": [
                "openocd_dap.cfg", // 配置文件已经在根目录提供,若要修改以此类推,openocd的路径下的share/scripts中有各种写好的配置文件
            ],
            "runToEntryPoint": "main", // 调试时在main函数入口停下
            "rtos": "FreeRTOS",
            "preLaunchTask": "build selected board for debug",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
            // dap若要使用log,请使用Jlink调试任务启动,之后再打开log任务
            // 若想要在调试前编译并且打开log,可只使用log的prelaunch task并为log任务添加depends on依赖
        },
        // 使用j-link进行调试时的参考配置
        {
            "name": "Jlink",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceRoot}\\build\\selected-board.elf",
            "request": "launch",
            "type": "cortex-debug",
            "device": "STM32F427II",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none",
            "servertype": "jlink",
            "interface": "swd",
            "svdFile": "STM32F427.svd",
            "rtos": "FreeRTOS",
            "preLaunchTask": "build selected board for debug",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
            //"preLaunchTask": "log", // 调试时同时开启RTT viewer窗口,若daplink使用jlinkGDBserver启动,需要先开始调试再打开log
            // 若想要在调试前编译并且打开log,可只使用log的prelaunch task并为log任务添加depends on依赖
        },
        {
            "name": "DAP-attach",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}\\build\\board-1-main\\basic_framework.elf",
            "request": "attach",
            "type": "cortex-debug",
            "device": "STM32F427II",
            "svdFile": "STM32F427.svd",
            "servertype": "openocd",
            "configFiles": [
                "openocd_dap.cfg",
            ],
        },
        {
            "name": "Jlink-attach",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceRoot}\\build\\selected-board.elf",
            "preLaunchTask": "prepare selected board symbols",
            "request": "attach",
            "type": "cortex-debug",
            "device": "STM32F427II",
            "showDevDebugOutput": "none",
            "servertype": "jlink",
            "interface": "swd",
            "svdFile": "STM32F427.svd",
            "rtos": "FreeRTOS",
        },
    ],
}
