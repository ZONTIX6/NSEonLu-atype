{
  "configurations": [
    {
      "name": "STM32F427 A-board",
      "includePath": [
        "${workspaceFolder}/**"
      ],
      "defines": [
        "USE_HAL_DRIVER",
        "STM32F427xx",
        "ARM_MATH_CM4"
      ],
      "cStandard": "c11",
      "cppStandard": "gnu++14",
      "intelliSenseMode": "gcc-arm",
      "configurationProvider": "ms-vscode.makefile-tools",
      "compileCommands": "${workspaceFolder}/build/cmake-atype-vehicle/compile_commands.json"
    }
  ],
  "version": 4
}
